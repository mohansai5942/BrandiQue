{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.brandique.in" }], "destination": "https://brandique.in/:path*", "permanent": true },
    { "source": "/services/full-stack-web-development", "destination": "/web-development", "permanent": true },
    { "source": "/services/wordpress-development", "destination": "/web-development", "permanent": true },
    { "source": "/services/full-stack", "destination": "/web-development", "permanent": true },
    { "source": "/services/wordpress", "destination": "/web-development", "permanent": true },
    { "source": "/services/branding-identity", "destination": "/services/graphic-design", "permanent": true },
    { "source": "/services/branding", "destination": "/services/graphic-design", "permanent": true },
    { "source": "/services/digital-marketing", "destination": "/services/graphic-design", "permanent": true }
  ],
  "headers": [
    { "source": "/admin/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/login/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-store" }] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), magnetometer=(), gyroscope=(), accelerometer=(), midi=(), interest-cohort=(), browsing-topics=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-NraBd1hddlT0KBw6EzRrBmKX8P6DRAwRQ/MqFLA48iY='; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://cdn.imgchest.com https://files.catbox.moe https://images.unsplash.com; media-src 'self' https://cdn.imgchest.com; connect-src 'self' https://data.brandique.in https://brandique-chatbot.vercel.app https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests" }
      ]
    }
  ]
}
