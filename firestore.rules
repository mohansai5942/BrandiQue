rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Messages collection: Allow any visitor to submit forms, and allow reading/updating/deleting across all devices
    match /messages/{messageId} {
      allow read, create, update, delete: if true;
    }

    // Projects collection: Allow reading and managing projects across all devices
    match /projects/{projectId} {
      allow read, create, update, delete: if true;
    }
  }
}
