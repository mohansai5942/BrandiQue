# Cloudflare Pages response headers (production). vercel.json is not used in production.
# The script-src sha256 hash covers the inline <script> block in index.html (theme switch).
# Tailwind is compiled at build time and fonts are self-hosted, so no CDN/Google Fonts origins. scripts/prerender.mjs recomputes them on every build and
# rewrites this file in dist/, and `npm run test:seo` fails if they ever drift.
# static.cloudflareinsights.com / cloudflareinsights.com: Cloudflare Web Analytics beacon, injected by Cloudflare at the edge.
# Content-Security-Policy-Report-Only is a trial only (it never blocks): it narrows img/media to the origins the
# site is known to use and trials Trusted Types. Check the browser console for violations before enforcing any of it.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), magnetometer=(), gyroscope=(), accelerometer=(), midi=(), interest-cohort=(), browsing-topics=()
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com 'sha256-NraBd1hddlT0KBw6EzRrBmKX8P6DRAwRQ/MqFLA48iY='; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://firestore.googleapis.com https://brandique-chatbot.vercel.app https://data.brandique.in https://formspree.io https://cloudflareinsights.com; frame-src 'self'; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  Content-Security-Policy-Report-Only: img-src 'self' data: blob: https://cdn.imgchest.com https://files.catbox.moe https://images.unsplash.com https://mohanwebdeveloperr.netlify.app https://firebasestorage.googleapis.com; media-src 'self' blob: https://cdn.imgchest.com https://files.catbox.moe https://mohanwebdeveloperr.netlify.app https://firebasestorage.googleapis.com; require-trusted-types-for 'script'
  ! Access-Control-Allow-Origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

# Legacy admin/login shells (they only redirect to data.brandique.in): never indexed, never cached.
/admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/login
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/login/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/404.html
  X-Robots-Tag: noindex, follow

# The *.pages.dev aliases (production + every preview deployment) serve the same site outside the
# brandique.in zone's WAF/rate-limit rules: keep them out of search results. Redirect or protect them
# with Cloudflare Access/Bulk Redirects in the dashboard (see the security-hardening PR).
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
