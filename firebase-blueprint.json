{
  "entities": {
    "Message": {
      "title": "Message",
      "description": "Contact form submissions from users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "service": { "type": "string" },
        "budget": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "serviceDetails": { "type": "object" }
      },
      "required": ["name", "email", "service", "budget", "message", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Projects, visual designs, or portfolios uploaded by the admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "desc": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "image": { "type": "string", "format": "uri" },
        "video": { "type": "string" },
        "link": { "type": "string", "format": "uri" },
        "type": { "type": "string", "enum": ["main", "portfolio", "figma", "client"] },
        "isDeleted": { "type": "boolean" },
        "deletedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "desc", "tags", "image", "link", "type", "createdAt"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global contact details and site configurations editable by admin",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "instagram": { "type": "string" },
        "whatsapp": { "type": "string" },
        "workingHours": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "WebsiteItem": {
      "title": "WebsiteItem",
      "description": "Custom site websites featured in Our Websites menu",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "url", "createdAt"]
    }
  },
  "firestore": {
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Collection of contact form submissions"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Collection of showcase and portfolio projects"
    },
    "/settings/{settingId}": {
      "schema": "SiteSettings",
      "description": "Collection of site configurations and global contact settings"
    },
    "/websites/{websiteId}": {
      "schema": "WebsiteItem",
      "description": "Collection of custom company website links displayed in Header menu"
    }
  }
}
